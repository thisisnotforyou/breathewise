# At least one AI key. If both are set, the first is used and the other is the automatic backup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: "openai" or "gemini" to force which one is primary
LLM_PROVIDER=
# Optional: free token from https://aqicn.org/data-platform/token/ for real monitoring-station hotspots on the map
WAQI_TOKEN=
# Optional: Google Maps Platform key with the "Map Tiles API" enabled, for the photo-real 3D landmark view.
# It is used in the browser, so restrict it to your site's domains (HTTP referrers) and to the Map Tiles API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: Google Places (New) for Google-Maps-quality search suggestions. Server-side only.
# Without it, search uses OpenStreetMap (Photon), which needs no key.
GOOGLE_PLACES_API_KEY=
